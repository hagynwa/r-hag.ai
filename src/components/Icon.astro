---
/**
 * Small inline icon set (stroke-based, 24px grid). Kept inline so there is
 * no icon font or extra request, and colors follow currentColor.
 */
type IconName = 'external' | 'github' | 'mail' | 'whatsapp' | 'linkedin' | 'phone' | 'pin' | 'sun' | 'moon' | 'menu' | 'arrow';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
const common: astroHTML.JSX.SVGAttributes = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 2,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
};
---

{name === 'external' && (
  <svg {...common} class={`flip-rtl ${className}`}>
    <path d="M7 17 17 7" /><path d="M8 7h9v9" />
  </svg>
)}
{name === 'arrow' && (
  <svg {...common} class={`flip-rtl ${className}`}>
    <path d="M5 12h14" /><path d="m13 6 6 6-6 6" />
  </svg>
)}
{name === 'github' && (
  <svg {...common} class={className}>
    <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5a5.2 5.2 0 0 0-1.5-3.5 4.8 4.8 0 0 0-.1-3.5s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.3 1.7 5.2 2 5.2 2a4.8 4.8 0 0 0-.1 3.5A5.2 5.2 0 0 0 3.6 9c0 3.5 3 5.5 6 5.5a4.8 4.8 0 0 0-1 3.5v4" />
    <path d="M9 18c-4.5 2-5-2-7-2" />
  </svg>
)}
{name === 'mail' && (
  <svg {...common} class={className}>
    <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
  </svg>
)}
{name === 'whatsapp' && (
  <svg {...common} class={className}>
    <path d="M3 21l1.6-4.6A8.9 8.9 0 1 1 8 19.6Z" />
    <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-1.8-.9-.9.8a4 4 0 0 1-2.2-2.2l.8-.9-.9-1.8Z" />
  </svg>
)}
{name === 'linkedin' && (
  <svg {...common} class={className}>
    <rect x="3" y="3" width="18" height="18" rx="3" />
    <path d="M8 10v7" /><path d="M8 7v.01" /><path d="M12 17v-4a2 2 0 0 1 4 0v4" /><path d="M12 10v7" />
  </svg>
)}
{name === 'phone' && (
  <svg {...common} class={className}>
    <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
  </svg>
)}
{name === 'pin' && (
  <svg {...common} class={className}>
    <path d="M12 21s-6-5.3-6-11a6 6 0 0 1 12 0c0 5.7-6 11-6 11Z" /><circle cx="12" cy="10" r="2.5" />
  </svg>
)}
{name === 'sun' && (
  <svg {...common} class={`icon-sun ${className}`}>
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.9 4.9 1.4 1.4" /><path d="m17.7 17.7 1.4 1.4" />
    <path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.3 17.7-1.4 1.4" /><path d="m19.1 4.9-1.4 1.4" />
  </svg>
)}
{name === 'moon' && (
  <svg {...common} class={`icon-moon ${className}`}>
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
  </svg>
)}
{name === 'menu' && (
  <svg {...common} class={className}>
    <path d="M4 7h16" /><path d="M4 12h16" /><path d="M4 17h16" />
  </svg>
)}
