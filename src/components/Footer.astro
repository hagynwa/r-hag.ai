---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { contact } from '../data/experience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <div class="left">
      <img class="logo" src="/brand/logo.png" srcset="/brand/logo.png 1x, /brand/logo@2x.png 2x" width="148" height="142" alt={t.nav.logoAlt} />
      <div>
        <p class="tagline">{t.footer.tagline}</p>
        <p class="copy"><span dir="ltr">r-hag.ai</span> © {year} Hagai Rettig · {t.footer.built}</p>
      </div>
    </div>
    <ul class="links">
      <li><a href={contact.linkedin.url} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href={`mailto:${contact.email}`}>Email</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 2.2rem 2.6rem;
    background: var(--surface);
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .logo {
    height: 56px;
    width: auto;
    padding: 4px 6px;
    border-radius: 10px;
  }
  :global([data-theme='dark']) .logo {
    background: #f5f8fb;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--accent-ink);
    margin-bottom: 0.2rem;
  }
  .copy {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 1.4rem;
  }
  .links a {
    font-size: 0.86rem;
    color: var(--text-2);
    transition: color 0.18s ease;
  }
  .links a:hover {
    color: var(--accent-ink);
  }
</style>
