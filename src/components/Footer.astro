---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { contact } from '../data/experience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <div class="left">
      <p class="tagline">{t.footer.tagline}</p>
      <p class="copy"><span dir="ltr">r-hag.ai</span> © {year} Hagai Rettig · {t.footer.built}</p>
    </div>
    <ul class="links">
      <li><a href={contact.linkedin.url} target="_blank" rel="noopener">LinkedIn</a></li>
      <li><a href={contact.github.url} target="_blank" rel="noopener">GitHub</a></li>
      <li><a href={`mailto:${contact.email}`}>Email</a></li>
      <li><a href={contact.siteSource} target="_blank" rel="noopener">{t.footer.source}</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: 2.2rem 2.6rem;
    background: var(--surface);
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .tagline {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    color: var(--accent-ink);
    margin-bottom: 0.3rem;
  }
  html[lang='he'] .tagline {
    font-family: var(--font-hebrew);
    font-weight: 500;
  }
  .copy {
    font-size: 0.82rem;
    color: var(--muted);
  }
  .links {
    display: flex;
    gap: 1.4rem;
  }
  .links a {
    font-size: 0.86rem;
    color: var(--text-2);
    transition: color 0.18s ease;
  }
  .links a:hover {
    color: var(--accent-ink);
  }
</style>
