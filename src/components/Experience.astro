---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { roles, education, military } from '../data/experience';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="section" id="experience">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.experience.label}</p>
      <h2 class="section-title">{t.experience.title}</h2>
    </header>

    <div class="layout">
      <ol class="timeline">
        {roles.map((r, i) => (
          <li class:list={['item', 'reveal', { current: r.current }]} style={`--d:${i * 60}ms`}>
            <span class="dot" aria-hidden="true"></span>
            <p class="period">
              <span>{r.from}</span> – <span>{r.to ?? t.experience.present}</span>
            </p>
            <h3>{r.role[lang]}</h3>
            <p class="org">{r.org[lang]}</p>
            <p class="summary">{r.summary[lang]}</p>
          </li>
        ))}
      </ol>

      <aside class="side">
        <figure class="portrait reveal">
          <img src="/portrait.jpg" width="800" height="1000" alt="Hagai Rettig" loading="lazy" decoding="async" />
        </figure>
        <div class="card block reveal" style="--d:60ms">
          <h3 class="block-title">{t.experience.education}</h3>
          {education.map((d) => (
            <div class="entry">
              <strong>{d.title[lang]}</strong>
              <span>{d.school[lang]}</span>
              <span class="note">{d.note[lang]}</span>
            </div>
          ))}
        </div>
        <div class="card block reveal" style="--d:120ms">
          <h3 class="block-title">{t.experience.military}</h3>
          <div class="entry">
            <strong>{military.title[lang]}</strong>
            <span>{military.org[lang]}</span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(260px, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .timeline {
    position: relative;
    padding-inline-start: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }
  .timeline::before {
    content: '';
    position: absolute;
    inset-inline-start: 5px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border);
    border-radius: 2px;
  }
  .item {
    position: relative;
  }
  .dot {
    position: absolute;
    inset-inline-start: -1.6rem;
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--border-strong);
  }
  .item.current .dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
    letter-spacing: 0.04em;
    margin-bottom: 0.25rem;
  }
  html[lang='he'] .period {
    font-family: var(--font-hebrew);
    font-size: 0.85rem;
    letter-spacing: 0;
  }
  h3 {
    font-size: 1.15rem;
  }
  .org {
    color: var(--accent-ink);
    font-weight: 500;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }
  .summary {
    font-size: 0.97rem;
    color: var(--text-2);
    line-height: 1.7;
    max-width: 60ch;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }
  .portrait {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
    aspect-ratio: 4 / 5;
    background: var(--surface-2);
  }
  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .block {
    padding: 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .block-title {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  html[lang='he'] .block-title {
    font-family: var(--font-hebrew);
    font-size: 0.86rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .entry {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-size: 0.9rem;
    color: var(--text-2);
  }
  .entry strong {
    color: var(--text);
    font-size: 0.97rem;
  }
  .entry .note {
    color: var(--muted);
    font-size: 0.85rem;
  }

  @media (max-width: 860px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
    }
    .portrait {
      max-width: 320px;
    }
  }
</style>
