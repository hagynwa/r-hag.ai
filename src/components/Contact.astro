---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { contact } from '../data/experience';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];

const cards = [
  {
    icon: 'mail' as const,
    title: t.contact.email,
    value: contact.email,
    href: `mailto:${contact.email}?subject=${encodeURIComponent('Reaching out from r-hag.ai')}`,
    cta: t.contact.write,
    external: false,
  },
  {
    icon: 'whatsapp' as const,
    title: t.contact.whatsapp,
    value: contact.whatsapp.display,
    href: contact.whatsapp.url,
    cta: t.contact.message,
    external: true,
  },
  {
    icon: 'linkedin' as const,
    title: t.contact.linkedin,
    value: contact.linkedin.display,
    href: contact.linkedin.url,
    cta: t.contact.connect,
    external: true,
  },
  {
    icon: 'github' as const,
    title: t.contact.github,
    value: contact.github.display,
    href: contact.github.url,
    cta: t.contact.follow,
    external: true,
  },
];
---

<section class="section contact" id="contact">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.contact.label}</p>
      <h2 class="section-title">{t.contact.title}</h2>
      <p class="section-lead">{t.contact.subtitle}</p>
    </header>

    <ul class="grid">
      {cards.map((c, i) => (
        <li class="card item reveal" style={`--d:${i * 60}ms`}>
          <a
            class="inner"
            href={c.href}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener' : undefined}
          >
            <span class="icon"><Icon name={c.icon} size={20} /></span>
            <span class="title">{c.title}</span>
            <span class="value" dir="ltr">{c.value}</span>
            <span class="cta">{c.cta} <Icon name="arrow" size={14} /></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="meta reveal">
      <a href={contact.phone.url}><Icon name="phone" size={15} /> <span dir="ltr">{contact.phone.display}</span></a>
      <span class="sep" aria-hidden="true">·</span>
      <span><Icon name="pin" size={15} /> {t.contact.location}</span>
    </p>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .item {
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .item:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.4rem 1.4rem 1.3rem;
    height: 100%;
  }
  .icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-soft);
    color: var(--accent-ink);
    margin-bottom: 0.7rem;
  }
  .title {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .value {
    font-size: 0.85rem;
    color: var(--text-2);
    word-break: break-all;
    text-align: start;
  }
  html[dir='rtl'] .value {
    text-align: right;
  }
  .cta {
    margin-top: 0.9rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent-ink);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    margin-top: 1.6rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .meta a,
  .meta > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .meta a:hover {
    color: var(--accent-ink);
  }
  .sep {
    color: var(--border-strong);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
