---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { contact } from '../data/experience';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="section contact" id="contact">
  <div class="container">
    <div class="panel reveal">
      <div class="panel-text">
        <p class="eyebrow">{t.contact.label}</p>
        <h2 class="section-title">{t.contact.title}</h2>
        <p class="section-lead">{t.contact.subtitle}</p>
        <div class="actions">
          <a class="btn btn-primary" href={contact.whatsapp.url} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={18} /> {t.contact.whatsapp}
          </a>
          <a
            class="btn btn-ghost"
            href={`mailto:${contact.email}?subject=${encodeURIComponent('Reaching out from r-hag.ai')}`}
          >
            <Icon name="mail" size={17} /> {t.contact.email}
          </a>
        </div>
      </div>

      <ul class="details">
        <li>
          <span class="k"><Icon name="whatsapp" size={16} /> WhatsApp</span>
          <a dir="ltr" href={contact.whatsapp.url} target="_blank" rel="noopener">{contact.whatsapp.display}</a>
        </li>
        <li>
          <span class="k"><Icon name="phone" size={16} /> {t.contact.phoneLabel}</span>
          <a dir="ltr" href={contact.phone.url}>{contact.phone.display}</a>
        </li>
        <li>
          <span class="k"><Icon name="mail" size={16} /> Email</span>
          <a dir="ltr" href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
        <li>
          <span class="k"><Icon name="linkedin" size={16} /> {t.contact.linkedin}</span>
          <a dir="ltr" href={contact.linkedin.url} target="_blank" rel="noopener">{contact.linkedin.display}</a>
        </li>
        <li>
          <span class="k"><Icon name="github" size={16} /> {t.contact.github}</span>
          <a dir="ltr" href={contact.github.url} target="_blank" rel="noopener">{contact.github.display}</a>
        </li>
        <li>
          <span class="k"><Icon name="pin" size={16} /></span>
          <span>{t.contact.location}</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding: clamp(1.8rem, 4vw, 3.2rem);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .panel::before {
    content: '';
    position: absolute;
    inset-inline-start: -15%;
    bottom: -60%;
    width: 50%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-soft), transparent 60%);
    pointer-events: none;
  }
  .panel-text {
    position: relative;
  }
  .section-title {
    margin-bottom: 0.6rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }
  .details {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding: 1.2rem 1.3rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .details li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .k {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .details a {
    color: var(--text);
    font-weight: 500;
    transition: color 0.18s ease;
    text-align: end;
  }
  .details a:hover {
    color: var(--accent-ink);
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
