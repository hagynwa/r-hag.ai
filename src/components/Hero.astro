---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="hero" id="top">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.lead}</p>
      <p class="motto">{t.hero.motto}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#work">{t.hero.ctaWork} <Icon name="arrow" size={16} /></a>
        <a class="btn btn-ghost" href="#contact">{t.hero.ctaContact}</a>
        <a class="btn btn-link" href="/hagai-cv.pdf" target="_blank" rel="noopener">
          {t.hero.ctaCv} <Icon name="external" size={15} />
        </a>
      </div>
    </div>

    <figure class="portrait">
      <div class="frame">
        <img src="/profile.jpeg" alt={t.hero.photoAlt} width="191" height="191" loading="eager" decoding="async" />
      </div>
      <figcaption>
        <span class="role">{t.hero.role}</span>
        <span class="org">{t.hero.org}</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(3rem, 9vw, 7rem));
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset-inline-end: -10%;
    top: -20%;
    width: min(60vw, 720px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-soft) 0%, transparent 62%);
    opacity: 0.9;
    pointer-events: none;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.9fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .lead {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    line-height: 1.7;
    color: var(--text-2);
    max-width: 58ch;
  }
  .motto {
    margin-top: 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-ink);
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  html[lang='he'] .motto {
    font-family: var(--font-hebrew);
    font-weight: 500;
    font-size: 0.98rem;
  }
  .motto::before {
    content: '';
    width: 34px;
    height: 1px;
    background: var(--accent);
    opacity: 0.7;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.2rem;
  }

  .portrait {
    justify-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .frame {
    position: relative;
    width: clamp(180px, 22vw, 236px);
    aspect-ratio: 1;
  }
  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 28px;
    border: 1.5px solid var(--accent);
    transform: translate(12px, 12px);
    opacity: 0.55;
  }
  html[dir='rtl'] .frame::before {
    transform: translate(-12px, 12px);
  }
  .frame img {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 28px;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
    background: var(--surface-2);
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding-inline-start: 0.2rem;
  }
  figcaption .role {
    font-weight: 600;
    font-size: 0.95rem;
  }
  figcaption .org {
    font-size: 0.88rem;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      order: -1;
      justify-self: start;
      flex-direction: row;
      align-items: center;
      gap: 1.1rem;
    }
    .frame {
      width: 108px;
    }
    .frame::before {
      transform: translate(7px, 7px);
      border-radius: 20px;
    }
    html[dir='rtl'] .frame::before {
      transform: translate(-7px, 7px);
    }
    .frame img {
      border-radius: 20px;
    }
  }
</style>
