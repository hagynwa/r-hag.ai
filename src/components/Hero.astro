---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { contact } from '../data/experience';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="hero" id="top">
  <canvas class="net" id="net" aria-hidden="true"></canvas>
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1>
        <span>{t.hero.title1}</span>
        <span class="gradient-text">{t.hero.title2}</span>
      </h1>
      <p class="lead">{t.hero.lead}</p>
      <div class="cta">
        <a class="btn btn-primary" href={contact.whatsapp.url} target="_blank" rel="noopener">
          <Icon name="whatsapp" size={18} /> {t.hero.ctaWhatsapp}
        </a>
        <a class="btn btn-ghost" href="#work">{t.hero.ctaWork} <Icon name="arrow" size={16} /></a>
        <a class="btn btn-link" href="/hagai-cv.pdf" target="_blank" rel="noopener">
          {t.hero.ctaCv} <Icon name="external" size={15} />
        </a>
      </div>
    </div>

    <div class="phone-wrap">
      <div class="phone" role="figure" aria-label={t.hero.chatAria}>
        <div class="phone-head">
          <img class="avatar" src="/brand/mark@2x.png" width="36" height="36" alt="" />
          <div class="who">
            <strong>{t.hero.chatName}</strong>
            <span><i class="dot-live"></i> {t.hero.chatStatus}</span>
          </div>
          <img class="me" src="/profile.jpeg" width="30" height="30" alt="" />
        </div>
        <ol class="thread" id="thread">
          {t.hero.chat.map((m) => (
            <li class:list={['msg', m.from]}>
              {m.who && <span class="from">{m.who}</span>}
              <p>{m.text}</p>
              {m.tag && (m.href ? (
                <a class="tag" href={m.href} target="_blank" rel="noopener">{m.tag} <Icon name="external" size={12} /></a>
              ) : (
                <span class="tag">{m.tag}</span>
              ))}
            </li>
          ))}
          <li class="msg out final">
            <p>{t.hero.yourTurn}</p>
            <a class="tag tag-cta" href={contact.whatsapp.url} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={13} /> {t.hero.yourTurnCta}
            </a>
          </li>
          <li class="typing" id="typing" aria-hidden="true"><span></span><span></span><span></span></li>
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  // ---- Chat playback -------------------------------------------------
  const thread = document.getElementById('thread');
  const typing = document.getElementById('typing');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (thread && typing) {
    const msgs = Array.from(thread.querySelectorAll<HTMLElement>('.msg'));
    if (reduce) {
      msgs.forEach((m) => m.classList.add('show'));
      typing.remove();
    } else {
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const scroll = () => thread.scrollTo({ top: thread.scrollHeight, behavior: 'smooth' });
      (async () => {
        await sleep(350);
        for (const m of msgs) {
          const out = m.classList.contains('out');
          typing.classList.toggle('out', out);
          typing.classList.add('show');
          scroll();
          await sleep(out ? 600 : 450);
          typing.classList.remove('show');
          m.classList.add('show');
          scroll();
          await sleep(out ? 1050 : 850);
        }
        typing.remove();
      })();
    }
  }

  // ---- Network background ----------------------------------------------
  const canvas = document.getElementById('net') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    type Node = { x: number; y: number; vx: number; vy: number; r: number; p: number };
    let nodes: Node[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const colors = () => {
      const dark = document.documentElement.getAttribute('data-theme') === 'dark';
      return dark
        ? { node: '47,208,195', line: '47,208,195', a: 0.9 }
        : { node: '12,43,78', line: '31,184,173', a: 0.7 };
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(70, Math.max(28, (w * h) / 22000)));
      nodes = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.22,
        vy: (Math.random() - 0.5) * 0.22,
        r: Math.random() * 1.6 + 1,
        p: Math.random() * Math.PI * 2,
      }));
    };

    const draw = (tick: number) => {
      const c = colors();
      ctx.clearRect(0, 0, w, h);
      const link = 130;
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        if (!reduce) {
          n.x += n.vx;
          n.y += n.vy;
          if (n.x < -10) n.x = w + 10;
          if (n.x > w + 10) n.x = -10;
          if (n.y < -10) n.y = h + 10;
          if (n.y > h + 10) n.y = -10;
        }
        for (let j = i + 1; j < nodes.length; j++) {
          const m = nodes[j];
          const dx = n.x - m.x;
          const dy = n.y - m.y;
          const d = Math.hypot(dx, dy);
          if (d < link) {
            ctx.strokeStyle = `rgba(${c.line},${(1 - d / link) * 0.32 * c.a})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(n.x, n.y);
            ctx.lineTo(m.x, m.y);
            ctx.stroke();
          }
        }
      }
      for (const n of nodes) {
        const pulse = 0.55 + 0.45 * Math.sin(tick / 900 + n.p);
        ctx.fillStyle = `rgba(${c.node},${(0.35 + 0.45 * pulse) * c.a})`;
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r + pulse * 0.8, 0, Math.PI * 2);
        ctx.fill();
      }
      if (!reduce) raf = requestAnimationFrame(draw);
    };

    const start = () => {
      cancelAnimationFrame(raf);
      resize();
      draw(0);
      if (!reduce) raf = requestAnimationFrame(draw);
    };
    start();
    window.addEventListener('resize', start);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) cancelAnimationFrame(raf);
      else if (!reduce) raf = requestAnimationFrame(draw);
    });
    // The running loop reads colors every frame; only a static render needs a redraw on theme change.
    new MutationObserver(() => {
      if (reduce) draw(0);
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(2.5rem, 7vw, 5.5rem));
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .net {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 60% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 80% at 60% 45%, #000 20%, transparent 75%);
    opacity: 0.9;
  }
  html[dir='rtl'] .net {
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 40% 45%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 80% at 40% 45%, #000 20%, transparent 75%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.85fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  h1 {
    display: flex;
    flex-direction: column;
  }
  .lead {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-2);
    max-width: 56ch;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2.2rem;
    align-items: center;
  }

  /* Phone --------------------------------------------------------------- */
  .phone-wrap {
    display: flex;
    justify-content: center;
  }
  .phone {
    width: min(100%, 380px);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 28px;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: clamp(440px, 58vh, 520px);
  }
  .phone-head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #fff;
    padding: 3px;
    border: 1px solid var(--border);
    object-fit: contain;
  }
  .who {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    flex: 1;
  }
  .who strong {
    font-family: var(--font-display);
    font-size: 0.95rem;
  }
  .who span {
    font-size: 0.74rem;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .who .dot-live {
    display: inline-block;
  }
  .me {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    object-fit: cover;
    opacity: 0.9;
  }
  .thread {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0.9rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background:
      radial-gradient(circle at 20% 10%, var(--accent-soft), transparent 45%),
      var(--bg);
    scrollbar-width: thin;
  }
  .msg {
    max-width: 84%;
    padding: 0.55rem 0.8rem 0.6rem;
    border-radius: 16px;
    font-size: 0.9rem;
    line-height: 1.45;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  html.js .msg {
    display: none;
  }
  html.js .msg.show {
    display: flex;
    animation: pop 0.32s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .msg.in {
    align-self: flex-start;
    background: var(--surface);
    border: 1px solid var(--border);
    border-start-start-radius: 6px;
  }
  .msg.out {
    align-self: flex-end;
    background: var(--btn-bg);
    color: var(--btn-fg);
    border-start-end-radius: 6px;
  }
  .from {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent-ink);
    letter-spacing: 0.02em;
  }
  .msg p {
    text-wrap: pretty;
  }
  .tag {
    align-self: flex-start;
    margin-top: 0.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
  }
  a.tag:hover {
    background: rgba(255, 255, 255, 0.28);
  }
  .tag-cta {
    background: var(--surface);
    color: var(--text);
    border-color: transparent;
    padding: 0.35rem 0.75rem;
    font-size: 0.78rem;
  }
  .tag-cta:hover {
    color: var(--accent-ink);
  }
  .msg.final {
    margin-top: 0.3rem;
  }
  .typing {
    display: none;
    align-self: flex-start;
    gap: 4px;
    padding: 0.6rem 0.8rem;
    border-radius: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .typing.show {
    display: inline-flex;
  }
  .typing.out {
    align-self: flex-end;
    background: var(--btn-bg);
    border-color: transparent;
  }
  .typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted);
    animation: blink 1s infinite ease-in-out;
  }
  .typing.out span {
    background: var(--btn-fg);
  }
  .typing span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    40% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .phone {
      height: clamp(420px, 60vh, 520px);
    }
  }
</style>
