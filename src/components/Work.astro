---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { featured, more, automations } from '../data/projects';
import Icon from './Icon.astro';
import Art from './Art.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const nameFor = (p: { name: string; nameHe?: string }) => (lang === 'he' && p.nameHe ? p.nameHe : p.name);
---

<section class="section" id="work">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.work.label}</p>
      <h2 class="section-title">{t.work.title}</h2>
      <p class="section-lead">{t.work.subtitle}</p>
    </header>

    <div class="grid">
      {featured.map((p, i) => (
        <article class:list={['card', 'project', p.size, 'reveal']} style={`--d:${(i % 3) * 70}ms`}>
          {p.cover && p.links.live && (
            <a class="cover" href={p.links.live} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
              <img src={p.cover.src} alt={p.cover.alt[lang]} width="1200" height="750" loading="lazy" decoding="async" />
            </a>
          )}
          {p.cover && !p.links.live && (
            <div class="cover">
              <img src={p.cover.src} alt={p.cover.alt[lang]} width="1200" height="750" loading="lazy" decoding="async" />
            </div>
          )}
          {p.art && <Art name={p.art} />}
          <div class="body">
            <div class="top">
              <h3>{nameFor(p)}</h3>
              <span class={`pill pill-${p.status}`}>{t.work.status[p.status]}</span>
            </div>
            <p class="tagline">{p.tagline[lang]}</p>
            <p class="story">{p.story[lang]}</p>
            <ul class="tags" aria-label="Stack">
              {p.tags[lang].map((tag) => <li>{tag}</li>)}
            </ul>
            {p.links.live && (
              <div class="links">
                <a href={p.links.live} target="_blank" rel="noopener">
                  {t.work.visit} <Icon name="external" size={15} />
                </a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="more reveal">
      <div class="more-head">
        <h3>{t.work.moreTitle}</h3>
        <p>{t.work.moreNote}</p>
      </div>
      <ul class="tiles">
        {more.map((m) => (
          <li>
            <strong>
              {nameFor(m)}
              {m.link && (
                <a href={m.link} target="_blank" rel="noopener" aria-label={`${nameFor(m)}: ${t.work.visit}`}>
                  <Icon name="external" size={13} />
                </a>
              )}
            </strong>
            <span>{m.line[lang]}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="more reveal">
      <div class="more-head">
        <h3>{t.work.autoTitle}</h3>
        <p>{t.work.autoNote}</p>
      </div>
      <ul class="tiles">
        {automations.map((m) => (
          <li>
            <strong>
              {nameFor(m)}
              {m.active && <em class="running"><i class="dot-live"></i>{t.work.running}</em>}
            </strong>
            <span>{m.line[lang]}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }
  .project {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .project.lg {
    grid-column: span 3;
  }
  .project.sm {
    grid-column: span 2;
  }
  .project:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }
  .cover {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s ease;
  }
  .project:hover .cover img {
    transform: scale(1.03);
  }
  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4rem 1.5rem 1.3rem;
  }
  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }
  .top h3 {
    font-size: 1.2rem;
  }
  .top .pill {
    margin-top: 0.2rem;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--accent-ink);
    margin-bottom: 0.6rem;
    line-height: 1.45;
  }
  .story {
    font-size: 0.93rem;
    color: var(--text-2);
    line-height: 1.68;
    flex: 1;
  }
  .sm .story {
    font-size: 0.9rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-2);
    white-space: nowrap;
  }
  html[lang='he'] .tags li {
    font-family: var(--font-hebrew);
    font-size: 0.78rem;
  }
  .links {
    display: flex;
    gap: 1.2rem;
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    transition: color 0.18s ease;
  }
  .links a:hover {
    color: var(--accent-ink);
  }

  .more {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2.2fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--border);
  }
  .more-head h3 {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }
  .more-head p {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
  }
  .tiles li {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .tiles li:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .tiles strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }
  .tiles strong a {
    color: var(--accent-ink);
    display: inline-flex;
  }
  .tiles span {
    font-size: 0.86rem;
    color: var(--text-2);
    line-height: 1.5;
  }
  .running {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-ink);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  html[lang='he'] .running {
    font-family: var(--font-hebrew);
    font-size: 0.74rem;
    letter-spacing: 0;
    text-transform: none;
  }
  .running .dot-live {
    display: inline-block;
  }

  @media (max-width: 960px) {
    .project.lg,
    .project.sm {
      grid-column: span 3;
    }
  }
  @media (max-width: 860px) {
    .more {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .project.lg,
    .project.sm {
      grid-column: span 6;
    }
    .body {
      padding: 1.2rem 1.2rem 1.1rem;
    }
    .tiles {
      grid-template-columns: 1fr;
    }
  }
</style>
