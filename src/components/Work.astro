---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { featured, more } from '../data/projects';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const nameFor = (p: { name: string; nameHe?: string }) => (lang === 'he' && p.nameHe ? p.nameHe : p.name);
---

<section class="section" id="work">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.work.label}</p>
      <h2 class="section-title">{t.work.title}</h2>
      <p class="section-lead">{t.work.subtitle}</p>
    </header>

    <div class="grid">
      {featured.map((p, i) => (
        <article class="card project reveal" style={`--d:${(i % 2) * 80}ms`}>
          <div class="top">
            <h3>{nameFor(p)}</h3>
            <span class={`pill pill-${p.status}`}>{t.work.status[p.status]}</span>
          </div>
          <p class="tagline">{p.tagline[lang]}</p>
          <p class="story">{p.story[lang]}</p>
          <ul class="tags" aria-label="Stack">
            {p.tags[lang].map((tag) => <li>{tag}</li>)}
          </ul>
          <div class="links">
            {p.links.live && (
              <a href={p.links.live} target="_blank" rel="noopener">
                {t.work.visit} <Icon name="external" size={15} />
              </a>
            )}
            {p.links.code && (
              <a href={p.links.code} target="_blank" rel="noopener">
                <Icon name="github" size={15} /> {t.work.code}
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="more reveal">
      <div class="more-head">
        <h3>{t.work.moreTitle}</h3>
        <p>{t.work.moreNote}</p>
      </div>
      <ul class="more-list">
        {more.map((m) => (
          <li>
            <strong>{nameFor(m)}</strong>
            <span>{m.line[lang]}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 1.7rem 1.4rem;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }
  .project:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.55rem;
  }
  .top h3 {
    font-size: 1.22rem;
    letter-spacing: -0.01em;
  }
  .top .pill {
    margin-top: 0.2rem;
  }
  .tagline {
    font-weight: 600;
    font-size: 1.02rem;
    color: var(--accent-ink);
    margin-bottom: 0.7rem;
    line-height: 1.45;
  }
  .story {
    font-size: 0.95rem;
    color: var(--text-2);
    line-height: 1.7;
    flex: 1;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text-2);
    white-space: nowrap;
  }
  html[lang='he'] .tags li {
    font-family: var(--font-hebrew);
    font-size: 0.78rem;
  }
  .links {
    display: flex;
    gap: 1.2rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
    transition: color 0.18s ease;
  }
  .links a:hover {
    color: var(--accent-ink);
  }

  .more {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 2.1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid var(--border);
  }
  .more-head h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }
  .more-head p {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .more-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 2rem;
  }
  .more-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-inline-start: 0.9rem;
    border-inline-start: 2px solid var(--border);
  }
  .more-list strong {
    font-size: 0.95rem;
  }
  .more-list span {
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .more {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .project {
      padding: 1.3rem 1.2rem 1.1rem;
    }
    .more-list {
      grid-template-columns: 1fr;
    }
  }
</style>
