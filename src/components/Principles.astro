---
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="section band principles" id="principles">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow">{t.principles.label}</p>
      <h2 class="section-title">{t.principles.title}</h2>
    </header>
    <ol class="grid">
      {t.principles.items.map((item, i) => (
        <li class="card item reveal" style={`--d:${i * 90}ms`}>
          <span class="num">0{i + 1}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .principles {
    position: relative;
    overflow: hidden;
  }
  .principles::before {
    content: '';
    position: absolute;
    inset-inline-end: -20%;
    top: -40%;
    width: 60vw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(47, 208, 195, 0.18), transparent 60%);
    pointer-events: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    position: relative;
  }
  .item {
    padding: 1.8rem 1.6rem 1.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .item:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
  }
  .num {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(120deg, #9fd9ff, #2fd0c3);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 0.4rem;
  }
  h3 {
    font-size: 1.15rem;
    line-height: 1.35;
  }
  p {
    font-size: 0.94rem;
    color: var(--text-2);
    line-height: 1.7;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
